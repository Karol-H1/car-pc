#:kivy 2.3
#:import theme theme
#:import ICONS theme.ICONS
#:import with_alpha theme.with_alpha
#:import Window kivy.core.window.Window
#:set BACKGROUND theme.BACKGROUND
#:set GLASS theme.GLASS
#:set GLASS_STRONG theme.GLASS_STRONG
#:set EDGE theme.EDGE
#:set TEXT theme.TEXT
#:set MUTED theme.MUTED
#:set DIM theme.DIM
#:set GOOD theme.GOOD
#:set DANGER theme.DANGER


# ================= Building blocks =================

# Frosted-glass card.
<Card@BoxLayout>:
    radius: 18
    canvas.before:
        Color:
            rgba: GLASS
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]
        Color:
            rgba: EDGE
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.radius)
            width: 1

# Darker card that floats over the map.
<FloatCard@HideBox>:
    radius: 16
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.45
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, -3
            blur_radius: 18
            border_radius: [self.radius] * 4
        Color:
            rgba: GLASS_STRONG
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.radius]
        Color:
            rgba: EDGE
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, self.radius)
            width: 1

# Text that fills its box, left-aligned, cut short with "..." when too long. Roboto, so any language works.
<Txt@Label>:
    text_size: self.size
    halign: "left"
    valign: "middle"
    shorten: True
    shorten_from: "right"
    color: TEXT
    font_size: 16

# Numbers and labels in the display font.
<Num@Txt>:
    font_name: "Display"

# Small uppercase heading above a card's content.
<Eyebrow@Num>:
    font_size: 13
    color: MUTED
    size_hint_y: None
    height: 18

# Text sized to its own content (for rows of mixed sizes).
<Fit@Label>:
    size_hint_x: None
    width: self.texture_size[0]
    color: TEXT

<IconLabel@Label>:
    icon: ""
    font_name: "Icons"
    text: ICONS.get(self.icon, "")
    font_size: 24
    color: TEXT

<IconButton>:
    font_name: "Icons"
    text: ICONS.get(self.icon, "")
    font_size: 30
    color: TEXT
    canvas.before:
        Color:
            rgba: 1, 1, 1, (0.16 if self.state == "down" else 0)
        Ellipse:
            pos: self.center_x - min(self.size) / 2, self.center_y - min(self.size) / 2
            size: min(self.size), min(self.size)

<RoundButton>:
    font_name: "Icons"
    text: ICONS.get(self.icon, "")
    font_size: self.height * 0.5
    color: self.icon_color
    canvas.before:
        Color:
            rgba: with_alpha(self.fill, 0.5 if self.state == "normal" else 0.9)
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, -2
            blur_radius: self.height * 0.55
            spread_radius: -4, -4
            border_radius: [self.height / 2] * 4
        Color:
            rgba: self.fill if self.state == "normal" else theme.shift_hue(self.fill, 0, value=0.78)
        Ellipse:
            pos: self.pos
            size: self.size

<RailButton>:
    orientation: "vertical"
    padding: 0, 6
    canvas.before:
        Color:
            rgba: with_alpha(app.accent, 0.16 if self.active else (0.08 if self.state == "down" else 0))
        RoundedRectangle:
            pos: self.x + 10, self.y + 2
            size: self.width - 20, self.height - 4
            radius: [14]
        Color:
            rgba: app.accent if self.active else (0, 0, 0, 0)
        RoundedRectangle:
            pos: self.x, self.center_y - 14
            size: 4, 28
            radius: [2]
    IconLabel:
        icon: root.icon
        font_size: 28
        color: app.accent if root.active else MUTED
    Label:
        text: root.caption
        font_name: "Display"
        font_size: 12
        size_hint_y: 0.5
        color: TEXT if root.active else DIM

# Custom look for the song progress bar (the leading "-" replaces Slider's built-in style).
<-SeekBar>:
    canvas:
        Color:
            rgba: 1, 1, 1, 0.16
        RoundedRectangle:
            pos: self.x + self.padding, self.center_y - 2
            size: self.width - 2 * self.padding, 4
            radius: [2]
        Color:
            rgba: app.accent
        RoundedRectangle:
            pos: self.x + self.padding, self.center_y - 2
            size: max(0, self.value_pos[0] - self.x - self.padding), 4
            radius: [2]
        Color:
            rgba: with_alpha(app.accent, 0.35 if self.dragging else 0.22)
        Ellipse:
            pos: self.value_pos[0] - (14 if self.dragging else 10), self.center_y - (14 if self.dragging else 10)
            size: (28, 28) if self.dragging else (20, 20)
        Color:
            rgba: 1, 1, 1, (1 if not self.disabled else 0)
        Ellipse:
            pos: self.value_pos[0] - 6, self.center_y - 6
            size: 12, 12

<EqualizerBars>:
    canvas:
        Color:
            rgba: self.color
        Rectangle:
            pos: self.x, self.y
            size: 3, max(2, self.height * self.levels[0])
        Rectangle:
            pos: self.x + 6, self.y
            size: 3, max(2, self.height * self.levels[1])
        Rectangle:
            pos: self.x + 12, self.y
            size: 3, max(2, self.height * self.levels[2])
        Rectangle:
            pos: self.x + 18, self.y
            size: 3, max(2, self.height * self.levels[3])

# Album cover with rounded corners and a soft shadow; a music note when there's no cover.
<CoverArt@FloatLayout>:
    radius: 12
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.55
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, -4
            blur_radius: 22
            border_radius: [self.radius] * 4
        Color:
            rgba: (1, 1, 1, 1) if app.cover_texture else with_alpha(app.accent, 0.22)
        RoundedRectangle:
            texture: app.cover_texture
            pos: self.pos
            size: self.size
            radius: [self.radius]
    IconLabel:
        icon: "music_note"
        font_size: root.height * 0.42
        color: app.accent
        opacity: 0 if app.cover_texture else 1
        pos_hint: {"center_x": 0.5, "center_y": 0.5}

# Rounded text button in the accent color.
<PillButton@ButtonBehavior+Label>:
    font_name: "Display"
    bold: True
    font_size: 18
    color: BACKGROUND
    canvas.before:
        Color:
            rgba: app.accent if self.state == "normal" else theme.shift_hue(app.accent, 0, value=0.78)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]

<TimeRow@BoxLayout>:
    spacing: 4
    size_hint_y: None
    height: 30
    opacity: 1 if app.track_duration else 0.4
    Fit:
        text: app.format_time(app.track_position)
        font_name: "Display"
        font_size: 14
        color: MUTED
    SeekBar:
        id: seek_bar
        min: 0
        max: max(1, app.track_duration)
        value: app.track_position
        disabled: not app.track_duration
        on_dragging: app.seeking = args[1]
        on_seek: app.seek_to(args[1])
    Fit:
        text: app.format_time(app.track_duration)
        font_name: "Display"
        font_size: 14
        color: MUTED


# ================= The whole screen =================

FloatLayout:
    AmbientBackground:
        accent: app.accent

    BoxLayout:
        # ----- Side rail -----
        BoxLayout:
            orientation: "vertical"
            size_hint_x: None
            width: 76
            padding: 0, 10, 0, 10
            spacing: 6
            IconLabel:
                icon: "directions_car"
                font_size: 30
                color: app.accent
                size_hint_y: None
                height: 50
            RailButton:
                icon: "home"
                caption: "HOME"
                active: screens.current == "home"
                on_release: app.switch_to("home")
            RailButton:
                icon: "map"
                caption: "MAP"
                active: screens.current == "map"
                on_release: app.switch_to("map")
            RailButton:
                icon: "library_music"
                caption: "MUSIC"
                active: screens.current == "music"
                on_release: app.switch_to("music")
            RailButton:
                icon: "phone"
                caption: "PHONE"
                active: screens.current == "phone"
                on_release: app.switch_to("phone")
            RailButton:
                icon: "videocam"
                caption: "DASHCAM"
                active: screens.current == "dashcam"
                on_release: app.switch_to("dashcam")
            Widget:

        BoxLayout:
            orientation: "vertical"

            # ----- Status bar -----
            BoxLayout:
                size_hint_y: None
                height: 40
                padding: 4, 6, 16, 0
                spacing: 6
                Fit:
                    text: app.clock_time
                    font_name: "Display"
                    bold: True
                    font_size: 28
                Fit:
                    text: app.clock_ampm
                    font_name: "Display"
                    font_size: 15
                    color: MUTED
                    padding: 0, 0, 0, 2
                Widget:
                    size_hint_x: None
                    width: 8
                Fit:
                    text: app.clock_date
                    font_name: "Display"
                    font_size: 16
                    color: MUTED
                Widget:
                Fit:
                    text: app.trip_text
                    font_name: "Display"
                    font_size: 16
                    color: app.accent
                Widget:
                    size_hint_x: None
                    width: 12
                IconLabel:
                    icon: "fiber_manual_record"
                    size_hint_x: None
                    width: 22 if app.dashcam_recording else 0
                    font_size: 14
                    color: DANGER
                    opacity: 1 if app.dashcam_recording else 0
                IconLabel:
                    icon: "phone_android"
                    size_hint_x: None
                    width: 28
                    font_size: 20
                    color: app.accent if app.mirror_state == "running" else DIM
                IconLabel:
                    icon: "headphones"
                    size_hint_x: None
                    width: 28
                    font_size: 20
                    color: GOOD if app.spotify_connected else DIM
                IconLabel:
                    icon: "gps_fixed" if app.gps_fix else "gps_not_fixed"
                    size_hint_x: None
                    width: 28
                    font_size: 20
                    color: app.accent if app.gps_fix else DIM
                IconLabel:
                    icon: "wifi" if app.wifi_on else "wifi_off"
                    size_hint_x: None
                    width: 28
                    font_size: 20
                    color: TEXT if app.wifi_on else DIM

            ScreenManager:
                id: screens
                HomeScreen:
                    name: "home"
                MapScreen:
                    name: "map"
                MusicScreen:
                    name: "music"
                PhoneScreen:
                    name: "phone"
                DashcamScreen:
                    name: "dashcam"

    # Incoming/active call: covers exactly the Home page's music card, so a Google Maps or offline
    # map route keeps showing beside it.
    CallPopup:
        shown: app.call_state != "none"
        opacity: 0
        size_hint: None, None
        size: (Window.width - 102) / 2.4, Window.height - 56
        pos: Window.width - 12 - self.width, 12
    ReverseOverlay:
        shown: app.reversing
    Splash:
        id: splash


# ================= Home =================
# The map card shows Google Maps from the phone when it's connected (its window sits exactly over
# map_card), and the offline map with its own turn card, arrival card and speed otherwise.

<HomeScreen>:
    BoxLayout:
        padding: 2, 4, 12, 12
        spacing: 12

        # ----- Map with floating cards -----
        FloatLayout:
            id: map_card
            size_hint_x: 1.4
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.5
                BoxShadow:
                    pos: self.pos
                    size: self.size
                    offset: 0, -4
                    blur_radius: 26
                    border_radius: [18] * 4
            NavMap:
                id: navmap
                accent: app.accent
                interactive: not app.google_on_home
                pos_hint: {"x": 0, "y": 0}
                on_destination: app.navigate_to(args[1], args[2])

            # Next turn
            FloatCard:
                shown: not app.google_on_home
                pos_hint: {"x": 0.03, "top": 0.97}
                size_hint: 0.94, None
                height: 76
                padding: 10
                spacing: 12
                IconLabel:
                    icon: app.banner_icon
                    size_hint_x: None
                    width: 56
                    font_size: 42
                    color: app.accent if app.has_route else MUTED
                    canvas.before:
                        Color:
                            rgba: with_alpha(app.accent, 0.16 if app.has_route else 0.07)
                        RoundedRectangle:
                            pos: self.pos
                            size: self.size
                            radius: [12]
                BoxLayout:
                    orientation: "vertical"
                    Num:
                        text: app.banner_title
                        font_size: 30
                        bold: True
                    Txt:
                        text: app.banner_text
                        font_size: 15
                        color: TEXT if app.has_route else MUTED

            # Arrival time, trip left, and the button to end the route
            FloatCard:
                shown: app.has_route and not app.google_on_home
                opacity: 0
                pos_hint: {"x": 0.03, "y": 0.04}
                size_hint: None, None
                size: 262, 56
                padding: 14, 4, 4, 4
                spacing: 4
                BoxLayout:
                    orientation: "vertical"
                    Num:
                        text: app.eta_arrival
                        font_size: 24
                        bold: True
                        color: app.accent
                    Num:
                        text: "ARRIVAL"
                        font_size: 11
                        color: MUTED
                BoxLayout:
                    orientation: "vertical"
                    Num:
                        text: app.eta_minutes
                        font_size: 22
                        bold: True
                    Num:
                        text: "MIN"
                        font_size: 11
                        color: MUTED
                BoxLayout:
                    orientation: "vertical"
                    Num:
                        text: app.eta_miles
                        font_size: 22
                        bold: True
                    Num:
                        text: "MILES"
                        font_size: 11
                        color: MUTED
                IconButton:
                    icon: "close"
                    font_size: 24
                    color: MUTED
                    size_hint_x: None
                    width: 46
                    on_release: app.cancel_route()

            # Speed
            FloatCard:
                shown: app.speed_text != "" and not app.google_on_home
                opacity: 0
                radius: 30
                pos_hint: {"right": 0.97, "y": 0.04}
                size_hint: None, None
                size: 60, 60
                orientation: "vertical"
                padding: 0, 8, 0, 8
                Label:
                    text: app.speed_text
                    font_name: "Display"
                    bold: True
                    font_size: 26
                    color: TEXT
                Label:
                    text: "MPH"
                    font_name: "Display"
                    font_size: 10
                    color: MUTED
                    size_hint_y: 0.45

            # Back to following the car
            FloatCard:
                shown: not navmap.following and not app.google_on_home
                opacity: 0
                radius: 24
                pos_hint: {"right": 0.97, "y": 0.2 if app.speed_text else 0.04}
                size_hint: None, None
                size: 48, 48
                IconButton:
                    icon: "my_location"
                    font_size: 24
                    color: app.accent
                    on_release: navmap.recenter()

        # ----- Music (a call pops up right over this card) -----
        BoxLayout:
            orientation: "vertical"

            # Now playing, on a blurred copy of the album cover
            BoxLayout:
                orientation: "vertical"
                padding: 14, 14, 14, 10
                spacing: 8
                canvas.before:
                    Color:
                        rgba: (1, 1, 1, 0.6) if app.backdrop_texture else GLASS
                    RoundedRectangle:
                        texture: app.backdrop_texture
                        pos: self.pos
                        size: self.size
                        radius: [18]
                    Color:
                        rgba: 0, 0, 0, (0.42 if app.backdrop_texture else 0)
                    RoundedRectangle:
                        pos: self.pos
                        size: self.size
                        radius: [18]
                    Color:
                        rgba: EDGE
                    Line:
                        rounded_rectangle: (self.x, self.y, self.width, self.height, 18)
                        width: 1
                BoxLayout:
                    size_hint_y: None
                    height: 18
                    Eyebrow:
                        text: "NOW PLAYING"
                    EqualizerBars:
                        playing: app.is_playing
                        color: app.accent
                        size_hint_x: None
                        width: 21
                AnchorLayout:
                    CoverArt:
                        size_hint: None, None
                        size: [min(self.parent.width, self.parent.height) - 8] * 2
                Txt:
                    text: app.track_title
                    font_size: 20
                    bold: True
                    halign: "center"
                    size_hint_y: None
                    height: 30
                Txt:
                    text: app.track_artist
                    font_size: 15
                    color: MUTED
                    halign: "center"
                    size_hint_y: None
                    height: 22
                TimeRow:
                BoxLayout:
                    size_hint_y: None
                    height: 60
                    IconButton:
                        icon: "skip_previous"
                        on_release: app.previous_track()
                    AnchorLayout:
                        RoundButton:
                            icon: "pause" if app.is_playing else "play_arrow"
                            fill: app.accent
                            size_hint: None, None
                            size: 56, 56
                            on_release: app.toggle_play()
                    IconButton:
                        icon: "skip_next"
                        on_release: app.next_track()



# ================= Music (full screen) =================

<MusicScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: (1, 1, 1, 0.55) if app.backdrop_texture else GLASS
            RoundedRectangle:
                texture: app.backdrop_texture
                pos: self.x + 2, self.y + 12
                size: self.width - 14, self.height - 16
                radius: [22]
            Color:
                rgba: 0, 0, 0, (0.5 if app.backdrop_texture else 0)
            RoundedRectangle:
                pos: self.x + 2, self.y + 12
                size: self.width - 14, self.height - 16
                radius: [22]
            Color:
                rgba: EDGE
            Line:
                rounded_rectangle: (self.x + 2, self.y + 12, self.width - 14, self.height - 16, 22)
                width: 1
        BoxLayout:
            pos_hint: {"x": 0, "y": 0}
            padding: 34, 40, 40, 44
            spacing: 34
            AnchorLayout:
                size_hint_x: None
                width: 300
                CoverArt:
                    radius: 18
                    size_hint: None, None
                    size: 290, 290
            BoxLayout:
                orientation: "vertical"
                spacing: 4
                Widget:
                    size_hint_y: 0.3
                BoxLayout:
                    size_hint_y: None
                    height: 20
                    Eyebrow:
                        text: "NOW PLAYING ON CIVIC"
                        color: app.accent
                    EqualizerBars:
                        playing: app.is_playing
                        color: app.accent
                        size_hint_x: None
                        width: 21
                Txt:
                    text: app.track_title
                    font_size: 30
                    bold: True
                    size_hint_y: None
                    height: 46
                Txt:
                    text: app.track_artist
                    font_size: 20
                    color: MUTED
                    size_hint_y: None
                    height: 30
                Txt:
                    text: app.track_album
                    font_size: 15
                    color: DIM
                    size_hint_y: None
                    height: 24
                Widget:
                TimeRow:
                BoxLayout:
                    size_hint_y: None
                    height: 96
                    spacing: 10
                    IconButton:
                        icon: "skip_previous"
                        font_size: 40
                        on_release: app.previous_track()
                    AnchorLayout:
                        RoundButton:
                            icon: "pause" if app.is_playing else "play_arrow"
                            fill: app.accent
                            size_hint: None, None
                            size: 80, 80
                            on_release: app.toggle_play()
                    IconButton:
                        icon: "skip_next"
                        font_size: 40
                        on_release: app.next_track()
                Widget:
                    size_hint_y: 0.2


# ================= Dashcam =================

<DashcamScreen>:
    FloatLayout:
        # Live view, letterboxed to the camera's 16:9 inside a rounded card
        Card:
            id: view
            pos_hint: {"x": 2 / max(1, root.width), "y": 12 / max(1, root.height)}
            size_hint: None, None
            size: root.width - 14, root.height - 16
            radius: 22
            orientation: "vertical"
            padding: 30
            canvas.after:
                Color:
                    rgba: (1, 1, 1, 1) if app.dashcam_texture and app.dashcam_recording else (0, 0, 0, 0)
                RoundedRectangle:
                    texture: app.dashcam_texture
                    size: self.width, min(self.height, self.width * 9 / 16)
                    pos: self.x, self.center_y - min(self.height, self.width * 9 / 16) / 2
                    radius: [22]
            # Shown while there's no camera
            Widget:
            IconLabel:
                icon: "videocam"
                font_size: 84
                color: DIM
                size_hint_y: None
                height: 100
                opacity: 0 if app.dashcam_recording else 1
            Label:
                text: "Dashcam not connected"
                font_name: "Display"
                bold: True
                font_size: 26
                size_hint_y: None
                height: 40
                color: TEXT
                opacity: 0 if app.dashcam_recording else 1
            Label:
                text: "Recording starts on its own when the USB camera is plugged in."
                font_size: 15
                color: MUTED
                size_hint_y: None
                height: 30
                opacity: 0 if app.dashcam_recording else 1
            Widget:

        # Recording badge
        BoxLayout:
            size_hint: None, None
            size: 132, 36
            pos_hint: {"x": 22 / max(1, root.width), "top": 1 - 22 / max(1, root.height)}
            padding: 12, 0
            spacing: 6
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.6
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [18]
            IconLabel:
                id: rec_dot
                icon: "fiber_manual_record"
                font_size: 16
                color: DANGER if app.dashcam_recording else DIM
                opacity: 1 if (app.dashcam_blink or not app.dashcam_recording) else 0.2
                size_hint_x: None
                width: 18
            Label:
                text: ("REC  " + app.dashcam_elapsed) if app.dashcam_recording else "OFFLINE"
                font_name: "Display"
                bold: True
                font_size: 16
                color: TEXT if app.dashcam_recording else MUTED

        # Storage and save
        HideBox:
            shown: app.dashcam_recording
            opacity: 0
            size_hint: None, None
            size: root.width - 58, 52
            pos_hint: {"x": 22 / max(1, root.width), "y": 26 / max(1, root.height)}
            padding: 14, 6, 6, 6
            spacing: 10
            canvas.before:
                Color:
                    rgba: 0, 0, 0, 0.6
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [26]
            Label:
                text: app.dashcam_note or app.dashcam_storage
                font_name: "Display"
                font_size: 16
                color: GOOD if app.dashcam_note else TEXT
                text_size: self.size
                halign: "left"
                valign: "middle"
                shorten: True
            PillButton:
                text: "SAVE CLIP"
                size_hint_x: None
                width: 140
                on_release: app.save_dashcam_clip()


# ================= Map: Google Maps, full size =================

# While mirroring, the phone's Google Maps window covers mirror_area exactly; what's drawn here only
# shows while it's starting, paused, or when there's no phone.
<MapScreen>:
    FloatLayout:
        Card:
            id: mirror_area
            pos_hint: {"x": 2 / max(1, root.width), "y": 12 / max(1, root.height)}
            size_hint: None, None
            size: root.width - 14, root.height - 16
            radius: 22
            orientation: "vertical"
            padding: 30
            Widget:
            IconLabel:
                icon: "map" if app.mirror_state in ("ready", "running") else ("warning" if app.mirror_state == "error" else "phone_android")
                font_size: 84
                color: app.accent if app.mirror_state != "error" else theme.WARNING
                size_hint_y: None
                height: 100
                canvas.before:
                    Color:
                        rgba: with_alpha(app.accent, 0.25)
                    Rectangle:
                        texture: theme.glow_texture()
                        pos: self.center_x - 110, self.center_y - 110
                        size: 220, 220
            Label:
                text: "Google Maps"
                font_name: "Display"
                bold: True
                font_size: 28
                size_hint_y: None
                height: 42
                color: TEXT
            Label:
                text: app.mirror_message
                halign: "center"
                text_size: self.width, None
                font_size: 15
                color: MUTED
                size_hint_y: None
                height: 46
            AnchorLayout:
                size_hint_y: None
                height: 56
                HideBox:
                    shown: app.mirror_state == "error" and root.manager is not None and root.manager.current == "map"
                    opacity: 0
                    size_hint: None, None
                    size: 150, 46
                    PillButton:
                        text: "TRY AGAIN"
                        on_release: app.retry_mirror()
            Widget:


# ================= Incoming / active call =================

<CallPopup@Panel>:
    canvas.before:
        Color:
            rgba: 0, 0, 0, 0.5
        BoxShadow:
            pos: self.pos
            size: self.size
            offset: 0, -4
            blur_radius: 26
            border_radius: [18] * 4
        Color:
            rgba: 0.04, 0.06, 0.07, 0.98
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [18]
        Color:
            rgba: with_alpha(GOOD, 0.20)
        Rectangle:
            texture: theme.glow_texture()
            pos: self.center_x - 200, self.y + self.height * 0.66 - 200
            size: 400, 400
        Color:
            rgba: with_alpha(GOOD, 0.35)
        Line:
            rounded_rectangle: (self.x, self.y, self.width, self.height, 18)
            width: 1.2
    Label:
        text: "INCOMING CALL" if app.call_state == "incoming" else "ON CALL"
        font_name: "Display"
        bold: True
        font_size: 14
        color: GOOD
        size_hint: 1, None
        height: 20
        pos_hint: {"center_x": 0.5, "top": 0.96}
    PulseRings:
        running: root.shown and app.call_state == "incoming"
        inner: 46
        size_hint: None, None
        size: 220, 220
        pos_hint: {"center_x": 0.5, "center_y": 0.66}
    Label:
        text: (app.caller_name[:1] or "?").upper()
        font_name: "Display"
        bold: True
        font_size: 44
        color: TEXT
        size_hint: None, None
        size: 92, 92
        pos_hint: {"center_x": 0.5, "center_y": 0.66}
        canvas.before:
            Color:
                rgba: theme.shift_hue(GOOD, 0, value=0.55)
            Ellipse:
                pos: self.pos
                size: self.size
    Txt:
        text: app.caller_name
        font_size: 24
        bold: True
        halign: "center"
        size_hint: 0.9, None
        height: 34
        pos_hint: {"center_x": 0.5, "center_y": 0.37}
    Label:
        text: app.caller_detail if app.call_state == "incoming" else app.call_timer
        font_name: "Display"
        font_size: 18
        color: MUTED
        size_hint: 1, None
        height: 26
        pos_hint: {"center_x": 0.5, "center_y": 0.29}
    BoxLayout:
        size_hint: None, None
        size: (64 * 2 + 64, 64) if app.call_state == "incoming" else (64, 64)
        pos_hint: {"center_x": 0.5, "y": 0.06}
        spacing: 64 if app.call_state == "incoming" else 0
        RoundButton:
            icon: "call_end"
            fill: DANGER
            icon_color: TEXT
            on_release: app.end_call()
        RoundButton:
            icon: "call"
            fill: GOOD
            icon_color: TEXT
            size_hint_x: 1 if app.call_state == "incoming" else 0
            opacity: 1 if app.call_state == "incoming" else 0
            disabled: app.call_state != "incoming"
            on_release: app.answer_call()


# ================= Phone =================

# One row in the Recents or Contacts list.
<CallRow@ButtonBehavior+BoxLayout>:
    name: ""
    number: ""
    detail: ""
    icon: "person"
    icon_color: MUTED
    size_hint_y: None
    height: 58
    padding: 10, 4, 6, 4
    spacing: 12
    on_release: app.place_call(self.number, self.name)
    canvas.before:
        Color:
            rgba: 1, 1, 1, (0.08 if self.state == "down" else 0)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [12]
    IconLabel:
        icon: root.icon
        color: root.icon_color
        font_size: 20
        size_hint_x: None
        width: 40
        canvas.before:
            Color:
                rgba: 1, 1, 1, 0.06
            Ellipse:
                pos: self.center_x - 20, self.center_y - 20
                size: 40, 40
    BoxLayout:
        orientation: "vertical"
        padding: 0, 6
        Txt:
            text: root.name or root.number
            font_size: 17
        Txt:
            text: root.detail
            font_size: 13
            color: MUTED
    IconLabel:
        icon: "call"
        color: GOOD
        font_size: 22
        size_hint_x: None
        width: 36

<TabButton@ButtonBehavior+Label>:
    active: False
    font_name: "Display"
    bold: True
    font_size: 15
    color: BACKGROUND if self.active else MUTED
    canvas.before:
        Color:
            rgba: app.accent if self.active else (1, 1, 1, 0.06)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [self.height / 2]

<KeyButton@ButtonBehavior+Label>:
    font_name: "Display"
    bold: True
    font_size: 28
    color: TEXT
    on_release: app.dial_press(self.text)
    canvas.before:
        Color:
            rgba: 1, 1, 1, (0.16 if self.state == "down" else 0.05)
        Ellipse:
            pos: self.center_x - min(self.size) / 2, self.center_y - min(self.size) / 2
            size: min(self.size), min(self.size)

<PhoneScreen>:
    BoxLayout:
        padding: 2, 4, 12, 12
        spacing: 12

        # ----- Recents / Contacts -----
        Card:
            size_hint_x: 1.4
            orientation: "vertical"
            padding: 12
            spacing: 10
            BoxLayout:
                size_hint_y: None
                height: 38
                spacing: 8
                TabButton:
                    text: "RECENTS"
                    active: app.phone_tab == "recents"
                    on_release: app.phone_tab = "recents"
                TabButton:
                    text: "CONTACTS"
                    active: app.phone_tab == "contacts"
                    on_release: app.phone_tab = "contacts"
            FloatLayout:
                RecycleView:
                    pos_hint: {"x": 0, "y": 0}
                    data: app.recent_rows if app.phone_tab == "recents" else app.contact_rows
                    viewclass: "CallRow"
                    bar_width: 4
                    scroll_type: ["bars", "content"]
                    RecycleBoxLayout:
                        default_size: None, 58
                        default_size_hint: 1, None
                        size_hint_y: None
                        height: self.minimum_height
                        orientation: "vertical"
                        spacing: 2
                Label:
                    text: app.phone_list_message
                    opacity: 1 if app.phone_list_message else 0
                    font_size: 15
                    color: MUTED
                    halign: "center"
                    text_size: self.width - 40, None
                    pos_hint: {"center_x": 0.5, "center_y": 0.5}

        # ----- Keypad -----
        Card:
            orientation: "vertical"
            padding: 14, 12
            spacing: 8
            BoxLayout:
                size_hint_y: None
                height: 46
                Label:
                    text: app.dial_number or "Enter a number"
                    font_name: "Display"
                    bold: bool(app.dial_number)
                    font_size: 28 if app.dial_number else 18
                    color: TEXT if app.dial_number else DIM
                    text_size: self.size
                    halign: "center"
                    valign: "middle"
                    shorten: True
                    shorten_from: "left"
                IconButton:
                    icon: "backspace"
                    font_size: 24
                    color: MUTED
                    size_hint_x: None
                    width: 46
                    on_release: app.dial_number = app.dial_number[:-1]
            GridLayout:
                cols: 3
                spacing: 6
                KeyButton:
                    text: "1"
                KeyButton:
                    text: "2"
                KeyButton:
                    text: "3"
                KeyButton:
                    text: "4"
                KeyButton:
                    text: "5"
                KeyButton:
                    text: "6"
                KeyButton:
                    text: "7"
                KeyButton:
                    text: "8"
                KeyButton:
                    text: "9"
                KeyButton:
                    text: "*"
                KeyButton:
                    text: "0"
                KeyButton:
                    text: "#"
            AnchorLayout:
                size_hint_y: None
                height: 64
                RoundButton:
                    icon: "call"
                    fill: GOOD
                    icon_color: TEXT
                    size_hint: None, None
                    size: 58, 58
                    on_release: app.place_call(app.dial_number, "")


# ================= Reverse camera =================

<ReverseOverlay@Overlay>:
    fade: 0
    canvas.before:
        Color:
            rgba: 0, 0, 0, 1
        Rectangle:
            pos: self.pos
            size: self.size
    Label:
        text: "Waiting for camera signal..."
        font_name: "Display"
        font_size: 18
        color: DIM
        pos_hint: {"center_x": 0.5, "center_y": 0.7}
        size_hint: None, None
        size: 400, 30
    ParkingGuides:
        pos_hint: {"x": 0, "y": 0}
    BoxLayout:
        size_hint: None, None
        size: 168, 40
        pos_hint: {"center_x": 0.5, "top": 0.96}
        padding: 14, 0
        spacing: 8
        canvas.before:
            Color:
                rgba: DANGER
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [20]
        IconLabel:
            icon: "camera_rear"
            font_size: 22
            size_hint_x: None
            width: 26
        Label:
            text: "REVERSE"
            font_name: "Display"
            bold: True
            font_size: 20
            color: TEXT


# ================= Startup =================

<Splash@Overlay>:
    fade: 0.5
    glow: 0
    canvas.before:
        Color:
            rgba: BACKGROUND
        Rectangle:
            pos: self.pos
            size: self.size
        Color:
            rgba: with_alpha(app.accent, self.glow)
        Rectangle:
            texture: theme.glow_texture()
            pos: self.center_x - 360, self.center_y - 330
            size: 720, 720
    Label:
        id: title
        text: "C I V I C"
        font_name: "Display"
        bold: True
        font_size: 80
        color: TEXT
        opacity: 0
        pos_hint: {"center_x": 0.5, "center_y": 0.56}
    Widget:
        id: line
        size_hint: None, None
        size: 0, 3
        pos_hint: {"center_x": 0.5, "center_y": 0.43}
        canvas:
            Color:
                rgba: app.accent
            Rectangle:
                pos: self.pos
                size: self.size
    Label:
        id: subtitle
        text: "C A R    P C"
        font_name: "Display"
        font_size: 18
        color: MUTED
        opacity: 0
        pos_hint: {"center_x": 0.5, "center_y": 0.36}
